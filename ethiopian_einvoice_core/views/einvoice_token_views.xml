<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_einvoice_token_tree" model="ir.ui.view">
        <field name="name">einvoice.token.tree</field>
        <field name="model">einvoice.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="config_id"/>
                <field name="expiry_datetime"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_token_form" model="ir.ui.view">
        <field name="name">einvoice.token.form</field>
        <field name="model">einvoice.token</field>
        <field name="arch" type="xml">
            <form readonly="1">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="config_id"/>
                        <field name="expiry_datetime"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Token values (access token, refresh token, encryption key) are stored
                        securely outside the database and are not displayed here.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_einvoice_token" model="ir.actions.act_window">
        <field name="name">E-Invoice Tokens</field>
        <field name="res_model">einvoice.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_einvoice_token"
              name="Tokens"
              action="action_einvoice_token"
              parent="menu_einvoicing_root"
              sequence="20"/>
</odoo>

