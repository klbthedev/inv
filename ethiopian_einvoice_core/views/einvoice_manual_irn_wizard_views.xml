<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_einvoice_manual_irn_wizard_form" model="ir.ui.view">
        <field name="name">einvoice.manual.irn.wizard.form</field>
        <field name="model">einvoice.manual.irn.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual E-Invoice IRN Entry">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Use this form only when the EIMS accepted an invoice but the response was
                        lost before Odoo could save it.</strong>
                        Retrieve the IRN and details from the MoR portal and enter them here.
                        All entries are logged in the invoice chatter.
                    </div>

                    <group string="Search Invoice">
                        <field name="move_id"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Type invoice number, customer name…"/>
                    </group>

                    <group string="Invoice Summary" invisible="move_id == False">
                        <group>
                            <field name="move_name" readonly="1"/>
                            <field name="move_partner" readonly="1"/>
                            <field name="move_date" readonly="1"/>
                            <field name="move_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_irn" readonly="1"/>
                            <!-- <field name="current_status" readonly="1"/> -->
                            <field name="current_ack_date" readonly="1"/>
                            <field name="current_doc_number" readonly="1"/>
                        </group>
                    </group>

                    <group string="Entry Details" invisible="move_id == False">
                        <field name="entry_type" widget="radio"/>
                        <field name="irn" placeholder="e.g. 49a766cd3eaaa392efb912…"/>
                        <!-- <field name="status" placeholder="e.g. Active"/> -->
                        <field name="ack_date"/>
                        <field name="document_number" placeholder="e.g. 231"/>
                        <field name="signed_qr" widget="binary" filename="signed_qr_filename"/>
                        <field name="signed_qr_filename" invisible="1"/>
                    </group>

                    <group string="Audit">
                        <field name="reason"
                               placeholder="e.g. Connection timed out after EIMS accepted invoice 230 — retrieved IRN from MoR portal."
                               required = "move_id != False"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"
                            invisible = "move_id == False"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_einvoice_manual_irn_wizard" model="ir.actions.act_window">
        <field name="name">Manual IRN Entry</field>
        <field name="res_model">einvoice.manual.irn.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_einvoice_manual_irn"
              name="Manual IRN Entry"
              action="action_einvoice_manual_irn_wizard"
              parent="account.menu_finance_configuration"
              sequence="60"
              groups="ethiopian_einvoice_core.group_einvoice_user"/>

</odoo>
