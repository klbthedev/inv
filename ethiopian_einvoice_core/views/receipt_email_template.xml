<odoo>

    <record id="email_template_sales_receipt" model="mail.template">
        <field name="name">Sales Receipt Email</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Your Receipt - ${object.name}</field>
        <field name="email_from">${(object.company_id.email or user.email) | safe}</field>
        <field name="email_to">${object.partner_id.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Dear ${object.partner_id.name},</p>
                <p>Your receipt <strong>${object.name}</strong> has been successfully registered.</p>
                <p>Please find the receipt attached as PDF.</p>
                % if object.x_einvoice_receipt_rrn:
                <p>
                    <strong>RRN:</strong> ${object.x_einvoice_receipt_rrn or '—'}<br/>
                    <a href="${ctx.get('download_url', '')}" style="display:inline-block;padding:8px 16px;background:#1a5276;color:#fff;border-radius:4px;text-decoration:none;font-weight:bold;">⬇ Download Sales Receipt PDF</a>
                </p>
                % endif
                <p>Thank you for your business.</p>
                <p>Regards,<br/>${object.company_id.name}</p>
            ]]>
        </field>
    </record>

    <record id="email_template_invoice_registration" model="mail.template">
        <field name="name">E-Invoice Registration Notification</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Invoice ${object.name} registered - IRN: ${object.x_einvoice_irn or '—'}</field>
        <field name="email_from">${(object.company_id.email or user.email) | safe}</field>
        <field name="email_to">${object.partner_id.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Dear ${object.partner_id.name},</p>
                <p>Your invoice <strong>${object.name}</strong> has been registered with the E-Invoice system.</p>
                <p>
                    <strong>IRN:</strong> ${object.x_einvoice_irn or '—'}<br/>
                    <strong>Status:</strong> ${object.x_einvoice_status or '—'}<br/>
                    <strong>Acknowledged:</strong> ${object.x_einvoice_ack_date.strftime('%Y-%m-%d %H:%M') if object.x_einvoice_ack_date else '—'}
                </p>
                % if ctx.get('download_url'):
                <p>
                    <a href="${ctx.get('download_url', '')}" style="display:inline-block;padding:8px 16px;background:#1a5276;color:#fff;border-radius:4px;text-decoration:none;font-weight:bold;">⬇ Download Invoice PDF</a>
                </p>
                % endif
                % if object.x_einvoice_irn:
                <p><a href="https://portal.mor.gov.et/public/invoice?irn=${object.x_einvoice_irn}">View on MoR Portal</a></p>
                % endif
                <p>Regards,<br/>${object.company_id.name}</p>
            ]]>
        </field>
    </record>

