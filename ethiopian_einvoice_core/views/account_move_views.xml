<odoo>
    <record id="view_out_invoice_tree_einvoice" model="ir.ui.view">
        <field name="name">account.move.out.tree.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_bulk_send_to_einvoice"
                    type="object"
                    string="Send to E-Invoice (Bulk)"
                    class="btn-primary"
                    groups="ethiopian_einvoice_core.group_einvoice_user"
                />
            </xpath>
        </field>
    </record>
    <!-- <record id="view_move_form_debit_inherit_invoice_user" model="ir.ui.view">
        <field name="name">account.move.form.debit.invoice.user</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_debit_note.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_debit_note']" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </xpath>
        </field>
    </record> -->
    <record id="view_account_move_reversal_inherit_einvoice" model="ir.ui.view">
        <field name="name">account.move.reversal.einvoice</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="after">
                <field name="re_einvoice_reason" string="Reason" required="1"/>
            </xpath>
            <!-- <xpath expr="//field[@name='remarks']" position="after">
                <field name="re_einvoice_reason" required="1"/>
            </xpath> -->
        </field>
    </record>
    <record id="view_move_form_inherit_einvoice_reason" model="ir.ui.view">
        <field name="name">account.move.form.einvoice.reason</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_sales_type" string="Sales Type"/>
            </xpath>
            <xpath expr="//sheet//group" position="inside">
                <field name="re_einvoice_reason" string="Reason" invisible = "move_type != 'out_refund'"/>
                <field name="reason" string="Reason Detail" required="0"/>
            </xpath>
        </field>
    </record>


    <record id="view_move_form_einvoice" model="ir.ui.view">
        <field name="name">account.move.form.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_original_invoice"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="move_type != 'out_refund' or not related_invoice_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Original Invoice</span>
                    </div>
                </button>
            </xpath>
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_credit_notes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh" 
                        invisible="move_type != 'out_invoice' or credit_note_count == 0">
                    <field name="credit_note_count" widget="statinfo" string="Credit Notes"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_send_to_einvoice" string="Send to E-Invoice" groups="ethiopian_einvoice_core.group_einvoice_user" invisible = "move_type != 'out_invoice' or state == 'draft'" type="object" class="btn-primary"/>
                <button name="action_verify_einvoice" string="Verify E-Invoice" groups="ethiopian_einvoice_core.group_einvoice_user" invisible = "move_type != 'out_invoice' or state == 'draft'" type="object" class="btn-warning" />
                <button name="action_cancel_einvoice" string="Cancel E-Invoice" groups="ethiopian_einvoice_core.group_einvoice_user" invisible = "move_type != 'out_invoice' or state == 'draft'" type="object" class="btn-danger" />
                <button name="action_print_registered_einvoice" string="Print E-Invoice" groups="ethiopian_einvoice_core.group_einvoice_user" invisible="move_type != 'out_invoice' or not x_einvoice_irn" type="object"/>
                <button name="action_sales_withholding" string="Send Withholding" groups="ethiopian_einvoice_core.group_einvoice_user" invisible = "move_type != 'in_invoice' or state == 'draft'" type="object"/>
                <button name="action_send_credit_note" type="object" string="Send Credit Note" class="btn-primary" groups="ethiopian_einvoice_core.group_einvoice_user" invisible="move_type != 'out_refund' or state == 'draft' or x_einvoice_cn_irn"/>
                <button name="action_send_debit_note" type="object" string="Send Debit Note" class="btn-primary" groups="ethiopian_einvoice_core.group_einvoice_user" invisible="move_type != 'out_invoice' or state == 'draft' or not debit_origin_id or x_einvoice_cn_irn"/>


            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_total']" position="after">
                <field name="x_excise_tax_value_line" string="Excise (on gross)" optional="show" sum="Total"/>
                <field name="x_line_gross_extended" string="Line Gross (Qty×Price)" optional="show" sum="Total"/>
                <field name="x_line_total_wo_vat" string="Total Amount (w/o VAT)" optional="show" sum="Total"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="nature_of_goods" required="1" string="Nature of Goods"/>
            </xpath>

            <xpath expr="//group[contains(@class, 'oe_subtotal_footer')]/field[@name='tax_totals']" position="before">
                <field name="x_total_discount_amount" string="Total discount" colspan="2" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or x_total_discount_amount == 0"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside" >
                <page string="E-Invoice Informations">
                    <group string="Buyer Details">
                        <group >
                            <field name="partner_id"/>
                            <field name="buyer_vat"/>
                            <field name="buyer_phone" placeholder="eg. 0911223344"/>
                            <field name="buyer_email"/>
                            <field name="buyer_country"/>
                            
                        </group>       
                        <group>
                            <field name="buyer_region"/>
                            <field name="buyer_city"/>
                            <field name="buyer_wereda"/>
                            <field name="buyer_house_number"/>
                            <field name="buyer_id_type"/>
                            <field name="buyer_number"/>
                        </group>                 
                    </group>
                    
                    <group string="Payment and Transaction Types">
                        <group>
                            <field name="transaction_type"/>
                            <field name="mode_of_payment"/>
                            <field name="payment_term"/>
                            <field name="x_clicked_by_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Receipt">
                        <group>
                            <field name="mode_of_payment_receipt"/>
                            <field name="payment_service_provider"/>
                            <field name="account_number"/>
                            <field name="transaction_number"/>
                            <field name="payment_coverage"/>
                            <field name="remaining_amount"/>
                            <field name="einvoice_submission_count"/>
                        </group>
                    </group>
                    <group string="Client Geo-Location">
                        <group>
                            <field name="client_latitude"/>
                            <field name="client_longitude"/>
                            <field name="is_in_configured_location" readonly="1" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <button name="action_get_client_location" string="Get Current Location" type="object" class="btn-secondary" icon="fa-map-marker"/>
                        </group>
                    </group>
                    <!-- <separator string="Invoice Lines"/>
                    <field name="invoice_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_ids"/>
                        </list>
                    </field> -->
                </page>
                <page string="E-Invoice">
                    <group>
                        <group string="E-Invoice Registration">
                            <field name="x_einvoice_bulk_conversation_id" readonly="1"/>
                            <!-- <field name="x_einvoice_bulk_status" readonly="1"/> -->
                            <field name="x_einvoice_bulk_sent_at" readonly="1"/>
                            <field name="x_einvoice_irn" readonly="1"/>
                            <field name="x_einvoice_status" readonly="1"/>
                            <field name="x_einvoice_ack_date" readonly="1"/>
                            <field name="x_einvoice_document_number" readonly="1"/>
                            <!-- <field name="x_einvoice_signed_invoice" widget="image" readonly="1"/> -->
                            <field name="x_einvoice_signed_qr" widget="image" readonly="1"/>
                            <field name="x_einvoice_error_message" readonly="1"/>
                            <field name="x_einvoice_response_raw" widget="json" readonly="1"/>
                            <div class="mt-2" invisible="not x_einvoice_irn or move_type in ['out_refund']" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_invoice_registration" type="object" string="SMS Registration" class="btn-link"/>
                                <button name="action_email_invoice_registration" type="object" string="Email Registration" class="btn-link"/>
                            </div>
                        </group>
                        
                    </group>
                    <group>
                        <group string="E-Invoice Cancellation">
                            <field name="x_einvoice_cancel_status" readonly="1"/>
                            <field name="x_einvoice_cancel_date" readonly="1"/>
                            <field name="x_einvoice_cancel_response" readonly="1"/>
                            <div class="mt-2" invisible="x_einvoice_cancel_status != 'cancelled'" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_cancellation" type="object" string="SMS Cancellation" class="btn-link"/>
                                <button name="action_email_cancellation" type="object" string="Email Cancellation" class="btn-link"/>
                            </div>
                        </group>
                        <group string="E-Invoice Verification">
                            <field name="x_einvoice_verified_status" readonly="1"/>
                            <field name="x_einvoice_verified_details" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Credit Note Registration">
                            <field name="x_einvoice_credit_irn" readonly="1"/>
                            <field name="x_einvoice_credit_status" readonly="1"/>
                            <field name="x_einvoice_credit_ack_date" readonly="1"/>
                            <field name="x_einvoice_credit_document_number" readonly="1"/>
                            <field name="x_einvoice_credit_signed_qr" widget="image" readonly="1"/>
                            <field name="x_einvoice_credit_error_message" readonly="1"/>
                            <field name="x_einvoice_credit_response_raw" widget="json" readonly="1"/>
                            <div class="mt-2" invisible="not x_einvoice_cn_irn" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_credit_note" type="object" string="SMS Credit Note" class="btn-link"/>
                                <button name="action_email_credit_note" type="object" string="Email Credit Note" class="btn-link"/>
                            </div>
                        </group>
                        <group string="Debit Note Registration">
                            <field name="x_einvoice_debit_irn" readonly="1"/>
                            <field name="x_einvoice_debit_status" readonly="1"/>
                            <field name="x_einvoice_debit_ack_date" readonly="1"/>
                            <field name="x_einvoice_debit_document_number" readonly="1"/>
                            <field name="x_einvoice_debit_signed_qr" widget="image" readonly="1"/>
                            <field name="x_einvoice_debit_error_message" readonly="1"/>
                            <field name="x_einvoice_debit_response_raw" widget="json" readonly="1"/>
                            <div class="mt-2" invisible="not x_einvoice_cn_irn" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_debit_note" type="object" string="SMS Debit Note" class="btn-link"/>
                                <button name="action_email_credit_note" type="object" string="Email Debit Note" class="btn-link"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Receipt">
                            <!-- <field name="x_einvoice_receipt_status" readonly="1"/> -->
                            <field name="x_einvoice_receipt_id" readonly="1"/>
                            <field name="x_einvoice_receipt_status_code" readonly="1"/>
                            <field name="x_einvoice_receipt_rrn" readonly="1"/>
                            <field name="x_einvoice_receipt_qr" widget="image" readonly="1"/>
                            <field name="x_einvoice_receipt_response_raw" readonly="1"/>
                            <div class="mt-2" invisible="not x_einvoice_receipt_rrn and not x_einvoice_receipt_qr" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_sales_receipt" type="object" string="SMS Sales Receipt" class="btn-link"/>
                                <button name="action_send_sales_receipt_email" type="object" string="Email Sales Receipt" class="btn-link"/>
                            </div>
                        </group>
                        <group string="Withholding">
                            <field name="x_withholding_invoice_irn" readonly="1"/>
                            <field name="x_withholding_external_id" readonly="1"/>
                            <field name="x_withholding_status" readonly="1"/>
                            <field name="x_withholding_rrn" readonly="1"/>
                            <field name="x_withholding_qr" widget="image" readonly="1"/>
                            <field name="x_einvoice_receipt_response_raw" readonly="1"/>
                            <div class="mt-2" invisible="not x_withholding_rrn and not x_withholding_qr" groups="ethiopian_einvoice_core.group_einvoice_user">
                                <button name="action_sms_withholding_receipt" type="object" string="SMS Withholding Receipt" class="btn-link"/>
                                <button name="action_send_withholding_receipt_email" type="object" string="Email Withholding Receipt" class="btn-link"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
