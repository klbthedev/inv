<odoo>
    <record id="action_einvoice_counter" model="ir.actions.act_window">
        <field name="name">E-Invoice Counters</field>
        <field name="res_model">einvoice.counter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your fiscal invoice counters here.
            </p>
        </field>
    </record>

    <menuitem id="menu_einvoice_counter"
              name="E-Invoice Counters"
              parent="account.menu_finance_configuration"
              groups = "group_einvoice_user"
              action="action_einvoice_counter"
              sequence="61"/>

    <record id="view_einvoice_counter_tree" model="ir.ui.view">
        <field name="name">einvoice.counter.tree</field>
        <field name="model">einvoice.counter</field>
        <field name="arch" type="xml">
            <list string="E-Invoice Counters">
                <field name="config_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="next_number"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_counter_form" model="ir.ui.view">
        <field name="name">einvoice.counter.form</field>
        <field name="model">einvoice.counter</field>
        <field name="arch" type="xml">
            <form string="E-Invoice Counter">
                <sheet>
                    <group>
                        <field name="config_id" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="next_number"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>