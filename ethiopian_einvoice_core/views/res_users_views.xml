<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_einvoice" model="ir.ui.view">
        <field name="name">res.users.form.einvoice</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="E-Invoicing" groups="ethiopian_einvoice_core.group_einvoice_security">
                    <field name="einvoice_config_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_einvoice" model="ir.ui.view">
        <field name="name">res.users.preferences.form.einvoice</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="einvoice_config_id" groups="ethiopian_einvoice_core.group_einvoice_user"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
