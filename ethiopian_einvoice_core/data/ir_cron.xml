<odoo>
    <data noupdate="1">
        <record id="ir_cron_einvoice_config_token_refresh" model="ir.cron">
            <field name="name">E-Invoice Token Refresh</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">
for company in env['res.company'].search([]):
    token = env['einvoice.token'].search(
        [('company_id', '=', company.id), ('active', '=', True)],
        order='expiry_datetime desc',
        limit=1
    )
    if not token or token.is_expired():
        env['einvoice.auth.service'].authenticate(company)
            </field>
            <field name="interval_number">25</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

